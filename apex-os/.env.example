# Copy to .env and adjust. Never commit .env.
APEX_DATABASE_URL=sqlite:///./data/apex.db
APEX_DATA_DIR=./data
# Fernet key for field-level encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key file is created at $APEX_DATA_DIR/apex.key (mode 0600).
APEX_DATA_KEY=
APEX_TIMEZONE=Europe/Warsaw
APEX_INTERRUPT_BUDGET_PER_DAY=3
APEX_SCHEDULER_ENABLED=true
APEX_MORNING_BRIEF_HOUR=6
APEX_EVENING_REVIEW_HOUR=21
# Optional integrations (absent = not configured; system keeps working)
OPENAI_API_KEY=
