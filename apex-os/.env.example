# Copy to .env and adjust. Never commit .env.
APEX_DATABASE_URL=sqlite:///./data/apex.db
APEX_DATA_DIR=./data
# Fernet key for field-level encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key file is created at $APEX_DATA_DIR/apex.key (mode 0600).
APEX_DATA_KEY=
APEX_TIMEZONE=Europe/Warsaw
APEX_INTERRUPT_BUDGET_PER_DAY=3
APEX_SCHEDULER_ENABLED=true
APEX_MORNING_BRIEF_HOUR=6
APEX_EVENING_REVIEW_HOUR=21
# Claude (Anthropic API) - powers drafts, extraction and the autonomous mission agents
ANTHROPIC_API_KEY=
APEX_CLAUDE_MODEL=claude-opus-5-5
APEX_CLAUDE_EFFORT=high
APEX_LLM_DAILY_CALL_CAP=60
# Autonomous missions: cost guards (all missions together)
APEX_MISSIONS_ENABLED=true
APEX_MISSION_DAILY_TOKEN_CAP=2000000
APEX_MISSION_MAX_STEPS=16
APEX_MISSION_RUNS_PER_TICK=2
APEX_MAX_ACTIVE_MISSIONS=12
# Calendar: Google Calendar → Settings → your calendar → "Secret address in iCal format"
APEX_ICS_URL=
# Read-only plan feed at /calendar/<token>.ics (>= 24 random chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APEX_CALENDAR_FEED_TOKEN=
# Gmail: enable IMAP + create an app password (never use your main password)
APEX_IMAP_HOST=
APEX_IMAP_USER=
APEX_IMAP_PASSWORD=
# Push: ntfy topic URL with a long random topic name, or a webhook
APEX_NTFY_URL=
APEX_NTFY_TOKEN=
APEX_WEBHOOK_URL=
